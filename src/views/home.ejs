<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>home page</title>
    <link rel="stylesheet" href="css/styles.css">
</head>
<body>
    <div class="topnav">
        <a class="active" href="/">Home</a>
        <a href="/create">Create a User</a>
    </div>
    <div>
    <h1>Welcome to the Home Page</h1>

    <div>
        <table>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>EMAIL</th>
                <th>CITY</th>
            </tr>
            <% result.forEach(user => { %>
                <tr>
                    <td><%= user.id %></td>
                    <td><%= user.name %></td>
                    <td><%= user.email %></td>
                    <td><%= user.city %></td>
                </tr>
            <% }) %>
        </table>
    </div>
    </div>
</body>
</html>